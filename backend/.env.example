# Copiá este archivo a ".env" y completá los valores reales.
# El ".env" real NUNCA se sube a git (ya está en .gitignore).

# Cadena de conexión a PostgreSQL. Si usás el docker-compose que armamos,
# este valor ya funciona tal cual.
DATABASE_URL="postgresql://mindshore:mindshore@localhost:5432/mindshore_challenge"

# Puerto donde corre el backend
PORT=4000

# Secreto usado para firmar los JWT. En producción esto sería una cadena
# larga y random; para desarrollo local podés dejar este valor.
JWT_SECRET="cambiar-este-secreto-en-produccion"

# API key de NASA (gratis en https://api.nasa.gov). Si la dejás vacía,
# usamos la key pública "DEMO_KEY" que tiene límites bajos pero funciona.
NASA_API_KEY=DEMO_KEY

# API key de OpenAI. Si la dejás vacía, el servicio de IA cae automáticamente
# a modo "mock" (respuestas simuladas) para que la app funcione igual.
OPENAI_API_KEY=

# Origen permitido para CORS (la URL de tu frontend)
FRONTEND_URL="http://localhost:5173"
